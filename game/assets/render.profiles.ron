// Standard look: warm brass, cool sea reflections, luminous sanctuary.
// Authored offline studio cubemaps. Set both maps to None to compare the hemisphere fallback.
(
    camera_position: (10.0, 31.0, 17.0),
    camera_target: (0.0, 0.0, -2.3),
    fov_deg: 33.0,
    background: (0.065, 0.11, 0.17),
    environment_top: (0.82, 0.91, 1.0),
    environment_horizon: (0.30, 0.43, 0.49),
    environment_bottom: (0.025, 0.045, 0.07),
    environment_intensity: 450.0,
    diffuse_map: Some("lighting/studio_diffuse.ktx2"),
    specular_map: Some("lighting/studio_specular.ktx2"),
    key_color: (1.0, 0.86, 0.68),
    key_illuminance: 8000.0,
    key_position: (-8.0, 16.0, 3.0),
    bloom_intensity: 0.045,
    bloom_threshold: 1.8,
    exposure: -0.5,
    saturation: 1.0,
    fog_start: 45.0,
    fog_end: 80.0,
    mobile: (
        shadow_map_size: 1024, shadow_cascades: 1,
        shadow_distance: 65.0, shadow_first_cascade: 42.0,
        shadow_depth_bias: 0.04, shadow_normal_bias: 1.8,
        anti_aliasing: Msaa4, bloom: false, contact_shadows: false,
        contact_length: 0.15, contact_thickness: 0.04, contact_steps: 16,
        ssao_radius: None, ssao_thickness: 0.08, tone: AgX,
    ),
    standard: (
        shadow_map_size: 2048, shadow_cascades: 2,
        shadow_distance: 65.0, shadow_first_cascade: 42.0,
        shadow_depth_bias: 0.03, shadow_normal_bias: 1.0,
        anti_aliasing: Msaa4, bloom: true, contact_shadows: false,
        contact_length: 0.15, contact_thickness: 0.04, contact_steps: 16,
        ssao_radius: None, ssao_thickness: 0.08, tone: AgX,
    ),
    high: (
        shadow_map_size: 4096, shadow_cascades: 2,
        shadow_distance: 65.0, shadow_first_cascade: 42.0,
        shadow_depth_bias: 0.02, shadow_normal_bias: 0.6,
        anti_aliasing: Smaa, bloom: true, contact_shadows: true,
        contact_length: 0.15, contact_thickness: 0.04, contact_steps: 16,
        ssao_radius: Some(0.24), ssao_thickness: 0.08, tone: AgX,
    ),
    // Development only (F10). Never exposed in options or persisted.
    experimental: (
        shadow_map_size: 4096, shadow_cascades: 2,
        shadow_distance: 65.0, shadow_first_cascade: 42.0,
        shadow_depth_bias: 0.02, shadow_normal_bias: 0.25,
        anti_aliasing: Taa, bloom: true, contact_shadows: true,
        contact_length: 0.15, contact_thickness: 0.04, contact_steps: 24,
        ssao_radius: Some(0.24), ssao_thickness: 0.08, tone: KhronosPbrNeutral,
    ),
)
